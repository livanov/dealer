{
  "name": "dealer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Промоции от български магазини на едно място – статично PWA за GitHub Pages",
  "scripts": {
    "data": "node scripts/build-data.mjs",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "tsc -p scripts && vitest run",
    "lint": "eslint .",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geologica": "5.3.0",
    "preact": "10.26.9",
    "workbox-expiration": "7.3.0",
    "workbox-precaching": "7.3.0",
    "workbox-routing": "7.3.0",
    "workbox-strategies": "7.3.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.1",
    "@types/node": "22.20.5",
    "@typescript-eslint/parser": "8.71.1",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "sharp": "0.34.2",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.2.4"
  }
}
